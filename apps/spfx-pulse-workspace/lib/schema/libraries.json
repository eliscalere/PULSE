    },
    {
        "key": "reports",
        "title": "PULSE Reports",
        "description": "Generated outputs, exports, and leadership reports.",
        "versioningEnabled": true,
        "documentTemplate": "",
        "fields": [
            { "internalName": "ReportCategory", "displayName": "Report Category", "type": "Choice", "choices": [{ "value": "Leadership" }, { "value": "Project" }, { "value": "Operational" }] }
